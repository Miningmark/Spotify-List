# Spotify App Credentials (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Refresh Token mit Scope "user-read-recently-played"
SPOTIFY_REFRESH_TOKEN=

# MariaDB Verbindungsdaten
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=Spotify-test
DB_TABLE=spotify_tracks

# Cron-Ausdruck für den Sync (Standard: stündlich zur vollen Stunde)
SYNC_CRON=0 * * * *

# Zeitzone für den Scheduler
TZ=Europe/Berlin
